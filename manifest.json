{
	"manifest_version": 3,
	"name": "PDF Dark Mode",
	"version": "1.0.2",
	"host_permissions": ["<all_urls>"],
	"permissions": ["scripting", "activeTab", "storage"],
	"action": {
	  "default_popup": "popup.html",
	  "default_icon": "one.png"
	},
	"content_scripts": [
	  {
		"matches": ["<all_urls>"],
		"js": ["content.js"]
	  }
	]
  }
  